-- Synthetic deployment template. Replace placeholders only in setup.sql.
SET VARIABLE CDC_MYSQL_HOST = 'mysql.example.invalid';
SET VARIABLE CDC_MYSQL_PORT = 3306;
SET VARIABLE CDC_MYSQL_USER = 'cdc_user';
SET VARIABLE CDC_MYSQL_PASSWORD = 'CHANGE_ME_MYSQL_PASSWORD';
SET VARIABLE CDC_MYSQL_SCHEMA = 'demo_source';

SET VARIABLE CDC_SR_FE_HOST = 'starrocks.example.invalid';
SET VARIABLE CDC_SR_FE_PORT = 8030;
SET VARIABLE CDC_SR_QUERY_PORT = 9030;
SET VARIABLE CDC_SR_USER = 'load_user';
SET VARIABLE CDC_SR_PASSWORD = 'CHANGE_ME_STARROCKS_PASSWORD';
SET VARIABLE CDC_SR_DB = 'demo_target';

SET VARIABLE CDC_STATE_FILE = './runtime/state.sqlite3';
SET VARIABLE CDC_SERVER_ID = 10086;
SET VARIABLE CDC_LOAD_MODE = 'merge_async';

CREATE MACRO clean_text(x) AS trim(x);
CREATE VIEW model.clean_orders AS
SELECT id, clean_text(display_name) AS display_name, amount
FROM mysql.orders;

CREATE OR REPLACE TABLE starrocks.orders_clean AS
SELECT id, display_name, amount FROM model.clean_orders;
